# Backend API Endpoint
VITE_API_URL=https://rizumu-api.shore-keeper.com/api

# Socket.IO Endpoint
VITE_SOCKET_URL=https://rizumu-api.shore-keeper.com

# Optional Local Development Endpoints
VITE_DEV_API_URL=http://localhost:3001/api
VITE_DEV_SOCKET_URL=http://localhost:3001

# Spotify API Credentials
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Firebase Authentication (Google Sign-In)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
